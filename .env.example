# Copy this file to .env and change the values:  cp .env.example .env
# .env is listed in .gitignore and must never be committed.

# Signs the login cookie. Generate a random one with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Database used by Flask. Port 3307 avoids clashing with a MariaDB/MySQL
# already installed on your computer (which uses 3306).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=davokar
DB_USER=davokar
DB_PASSWORD=change-me

# Only used by docker compose to create the database container.
DB_ROOT_PASSWORD=change-me-too
