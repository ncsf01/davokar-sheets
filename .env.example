# copy to .env and change the values: cp .env.example .env

# random key: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# 3307 so it doesn't clash with a mariadb already installed on 3306
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=davokar
DB_USER=davokar
DB_PASSWORD=change-me

# only used by docker compose
DB_ROOT_PASSWORD=change-me-too
